# ============ 复制这个文件为 .env 再填值 ============
# cp .env.example .env

# ---- LLM：DeepSeek（任何 OpenAI 兼容接口都能用）----
# ⚠️ 模型名只有 deepseek-flash / deepseek-v4-pro 两个
#    没有 deepseek-v4.1-flash，填错会直接 404
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

# 工具循环用 flash（快、省）；规划节点想升级，把 PLAN 换成 deepseek-v4-pro
LLM_MODEL_TOOL=deepseek-flash
LLM_MODEL_PLAN=deepseek-flash

# ⚠️ 不要删这两个开关 —— 带 tools 的请求必须关思考，否则 DeepSeek 返回 400：
#    "The reasoning_content in the thinking mode must be passed back to the API."
#    规划节点不带 tools，可以开思考（保住 CoT 规划能力）
LLM_THINKING_TOOL=disabled
LLM_THINKING_PLAN=enabled

# 备选供应商（换回百炼只需要改上面 3 行，并把 thinking 开关留空）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_TOOL=qwen-plus

# ---- MySQL（Docker 起，要求 >= 8.0.19）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=travel
MYSQL_PASSWORD=
MYSQL_DB=travel_agent
# 仅供 docker-compose 初始化容器的 root 密码用（应用代码不连 root）
MYSQL_ROOT_PASSWORD=

# ============================================================
# 数据源开关
#   mock = 用内置的 9 个真实 POI，不联网、不吃高德配额
#          （M1 骨架 + 豆包并行开发都用它，不需要任何 Key）
#   real = 走真实高德 Web 服务（M2 起）
# ⚠️ 前端对这个开关**完全无感知**：接口路径与响应结构一模一样（D23）
# ============================================================
AMAP_PROVIDER=mock

# ============================================================
# 高德地图 —— 需要申请【两个】Key，不能互换
# 申请地址：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建应用
#          在同一个应用下点【添加Key】两次，分别选不同的服务平台
# ============================================================

# ---- ① 后端用：Key 的服务平台选「Web服务」----
# 用途：搜索 POI、测量距离、查询天气
# ⚠️ 只有 AMAP_PROVIDER=real 时才必须填；mock 模式下留空即可（config.py 会跳过校验）
AMAP_WEBSERVICE_KEY=

# ---- ② 前端用：Key 的服务平台选「Web端(JS API)」----
# 用途：在页面里画地图、打点、连线（界面二）
# 申请时会同时给出一个安全密钥 securityJsCode，两个都要填
# 这两个值后续会同步到 frontend/.env（Vite 要求 VITE_ 前缀才能暴露给浏览器）
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
