# ============ 复制这个文件为 .env 再填值 ============
# cp .env.example .env

# ---- LLM：主链路默认（任何 OpenAI 兼容接口都能用）----
# ⚠️ 模型名必须在本项目 MODEL_REGISTRY 里（backend/app/config.py）：
#    deepseek 系 = deepseek-flash / deepseek-v4-pro（没有 deepseek-v4.1-flash，填错 404）
#    qwen3.7 系  = qwen3.7-flash / qwen3.7-plus（走百炼，见下方 LLM_BAILIAN_API_KEY）
# registry 会按模型名的 provider 自动路由到对应 key/base_url —— 换供应商只改 LLM_MODEL_*
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

# 工具循环用 flash（快、省）；规划节点想升级，把 PLAN 换成 deepseek-v4-pro / qwen3.7-plus
#
# 🔴 下面两个是 **DeepSeek 官方名**，要用就得 `LLM_API_KEY` 有余额。
#    余额耗尽时**不抛异常、只是每个节点都失败** → 现象是"助手永远在追问、不推进"，
#    极易误判成代码 bug（2026-09-17 实际踩过一次，排查记录见 docs/LLM修复交接-20260917.md）。
#    免费跑法二选一（都走 `LLM_BAILIAN_API_KEY`）：
#      · deepseek-v4-flash-0731  百炼托管的同名模型（本项目当前在用这个）
#      · qwen3.7-flash           百炼自研
#    代价：百炼档慢 —— 一次 2 天行程约 140~214s；DeepSeek 付费档快一个量级
LLM_MODEL_TOOL=deepseek-flash
LLM_MODEL_PLAN=deepseek-flash

# ---- 百炼（DASHSCOPE）—— 会话选 qwen3.7 系才需要（D56/D58）----
# 免费额度按模型独立：qwen3.7-flash / qwen3.7-plus 各 100 万 token、90 天（北京地域）
LLM_BAILIAN_API_KEY=
LLM_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ⚠️ 不要删这两个开关 —— 带 tools 的节点必须关思考：
#    LLM_THINKING_TOOL=disabled  工具循环节点
#    LLM_THINKING_PLAN=enabled   规划 / 生成节点（不挂 tools，可以开）
#
#    理由 = **成本 + 确定性**，不是"会 400"：
#      ① reasoning_tokens 计入 completion_tokens。实测一个最简请求 = prompt 42 + completion 163，
#         其中推理占 160。工具循环 ≤8 轮，每轮开思考 = 多烧数倍 token
#      ② 思考模式下 temperature 失效（官方原话 "will also have no effect"）。
#         关掉后 temperature=0 才真正生效 → 同样的输入得到同样的工具选择
#    （旧版记的"带 tools + 历史缺 reasoning_content 必 400"已被复测推翻，
#      详见 DECISIONS.md D8；复现脚本 backend/scripts/probe_llm_structured.py）
LLM_THINKING_TOOL=disabled
LLM_THINKING_PLAN=enabled

# 备选供应商（换百炼只需要把上面 LLM_MODEL_* 改成 qwen3.7-flash，registry 自动路由）
# LLM_MODEL_TOOL=qwen3.7-flash
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- MySQL（Docker 起，要求 >= 8.0.19）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=travel
MYSQL_PASSWORD=
MYSQL_DB=travel_agent
# 仅供 docker-compose 初始化容器的 root 密码用（应用代码不连 root）
MYSQL_ROOT_PASSWORD=

# ============================================================
# 数据源开关（D66，2026-09-17 改过默认值）
#   real = 走真实高德 Web 服务（**默认档**，需要 AMAP_WEBSERVICE_KEY）
#   mock = 用内置的 9 个成都 POI，不联网、不吃高德配额、结果可复现
#          （单元测试 / 改代码时快速试 / 评测兜底 用它）
# ⚠️ 前端对这个开关**完全无感知**：接口路径与响应结构一模一样（D23）
# ⚠️ 写 real 但没填 AMAP_WEBSERVICE_KEY 时**不会报错**：启动日志打醒目警告，
#    并降级为 mock。**当前生效档看 GET /api/health**（`mock_mode` / `amap_degraded`），
#    不要翻这个文件 —— 它只代表"下次启动用什么"。
# ============================================================
AMAP_PROVIDER=real

# ============================================================
# 高德地图 —— 需要申请【两个】Key，不能互换
# 申请地址：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建应用
#          在同一个应用下点【添加Key】两次，分别选不同的服务平台
# ============================================================

# ---- ① 后端用：Key 的服务平台选「Web服务」----
# 用途：搜索 POI、测量距离、查询天气
# ⚠️ 留空不会让后端起不来（D66 的降级），但会一直跑演示数据 —— 填上才是真数据
AMAP_WEBSERVICE_KEY=

# ---- ② 前端用：Key 的服务平台选「Web端(JS API)」----
# 用途：在页面里画地图、打点、连线（界面二）
# 申请时会同时给出一个安全密钥 securityJsCode，两个都要填
# 这两个值后续会同步到 frontend/.env（Vite 要求 VITE_ 前缀才能暴露给浏览器）
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
