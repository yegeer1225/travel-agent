# ============ 复制这个文件为 .env 再填值 ============
# cp .env.example .env

# ---- LLM（任何 OpenAI 兼容接口都能用）----
# 阿里百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ============================================================
# 高德地图 —— 需要申请【两个】Key，不能互换
# 申请地址：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建应用
#          在同一个应用下点【添加Key】两次，分别选不同的服务平台
# ============================================================

# ---- ① 后端用：Key 的服务平台选「Web服务」----
# 用途：搜索 POI、测量距离、查询天气、静态地图
# 缺失时：M3 之前用 mock 数据，不影响 M1/M2
AMAP_WEBSERVICE_KEY=

# ---- ② 前端用：Key 的服务平台选「Web端(JS API)」----
# 用途：在页面里画地图、打点、连线（界面二）
# 申请时会同时给出一个安全密钥 securityJsCode，两个都要填
# 这两个值后续会同步到 frontend/.env（Vite 要求 VITE_ 前缀才能暴露给浏览器）
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
